# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321

# Error Logging Channel (ID канала куда отправлять ошибки)
ERROR_LOG_CHANNEL_ID=-1001234567890

# Backup Channel (ID канала куда отправлять резервные копии БД)
# Бэкапы будут отправляться автоматически каждые 6 часов
BACKUP_CHANNEL_ID=-1009876543210

# Database Configuration
DB_PATH=math_tutor.db

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Лимит токенов в минуту (TPM) вашей организации OpenAI — чтобы бот не упирался в 429.
# Посмотреть свой лимит: https://platform.openai.com/account/rate-limits
OPENAI_TPM_LIMIT=150000
# Прокси для OpenAI (если он недоступен напрямую из вашей сети/страны).
# Примеры: http://user:pass@host:port  или  socks5://host:port
# Оставьте пустым, если прокси не нужен.
# OPENAI_PROXY=

# Application Settings
DEBUG=False
